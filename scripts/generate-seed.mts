// Builds supabase/seed.sql from the seed data the services already ship, so the database and the
// in-memory fallbacks can never disagree. Dev data only: passwords here are for local use.
//
//   pnpm --filter @qc/identity exec tsx ../../scripts/generate-seed.mts

import { writeFileSync } from "node:fs";
import path from "node:path";
import {
  seedBanners,
  seedCategories,
  seedProductGroups,
  seedProductImages,
  seedProducts,
} from "../services/catalog/src/modules/catalog/seed";
import {
  seedStock,
  seedWarehouses,
} from "../services/warehouse-inventory/src/modules/inventory/seed";
import { hashPassword } from "../services/identity/src/modules/auth/password";

const q = (value: string | number | boolean | null | undefined): string => {
  if (value === null || value === undefined) return "null";
  if (typeof value === "number" || typeof value === "boolean") return String(value);
  return `'${value.replaceAll("'", "''")}'`;
};

const lines: string[] = [
  "-- GENERATED by scripts/generate-seed.mts. Do not edit by hand. Local development data only.",
  "",
  "-- catalog",
];

for (const c of seedCategories) {
  lines.push(
    `insert into catalog.categories (id, name, emoji, color, image_url, image_fit, sort_order, parent_id) values (${q(c.id)}, ${q(c.name)}, ${q(c.emoji)}, ${q(c.color)}, ${q(c.imageUrl)}, ${q(c.imageFit)}, ${c.sortOrder}, ${q(c.parentId)}) on conflict (id) do nothing;`,
  );
}
for (const g of seedProductGroups) {
  lines.push(
    `insert into catalog.product_groups (id, name, category_id, brand) values (${q(g.id)}, ${q(g.name)}, ${q(g.categoryId)}, ${q(g.brand)}) on conflict (id) do nothing;`,
  );
}
const textArray = (values: string[] | undefined) =>
  `array[${(values ?? []).map((v) => q(v)).join(", ")}]::text[]`;
for (const p of seedProducts) {
  lines.push(
    `insert into catalog.products (id, category_id, name, unit, price_paise, mrp_paise, emoji, image_url, image_fit, delivery_mins, options_count, description, brand, tags, group_id, variant_label) values (${q(p.id)}, ${q(p.categoryId)}, ${q(p.name)}, ${q(p.unit)}, ${p.pricePaise}, ${p.mrpPaise}, ${q(p.emoji)}, ${q(p.imageUrl)}, ${q(p.imageFit)}, ${p.deliveryMins}, ${q(p.optionsCount)}, ${q(p.description)}, ${q(p.brand)}, ${textArray(p.tags)}, ${q(p.groupId)}, ${q(p.variantLabel)}) on conflict (id) do nothing;`,
  );
}
for (const [i, img] of seedProductImages.entries()) {
  lines.push(
    `insert into catalog.product_images (product_id, url, alt, sort_order) select ${q(img.productId)}, ${q(img.url)}, ${q(img.alt)}, ${i} where not exists (select 1 from catalog.product_images where product_id = ${q(img.productId)} and url = ${q(img.url)});`,
  );
}
for (const b of seedBanners) {
  lines.push(
    `insert into catalog.banners (id, title, subtitle, image_url, link_type, link_target, color, sort_order, active, starts_at, ends_at) values (${q(b.id)}, ${q(b.title)}, ${q(b.subtitle)}, ${q(b.imageUrl)}, ${q(b.linkType)}, ${q(b.linkTarget)}, ${q(b.color)}, ${b.sortOrder}, ${b.active}, ${q(b.startsAt)}, ${q(b.endsAt)}) on conflict (id) do nothing;`,
  );
}

lines.push("", "-- inventory");
for (const w of seedWarehouses) {
  lines.push(
    `insert into inventory.warehouses (id, name, lat, lng, radius_km, open) values (${q(w.id)}, ${q(w.name)}, ${w.lat}, ${w.lng}, ${w.radiusKm}, ${w.open}) on conflict (id) do nothing;`,
  );
}
for (const s of seedStock) {
  lines.push(
    `insert into inventory.stock_items (warehouse_id, product_id, on_hand, max_per_order) values (${q(s.warehouseId)}, ${q(s.productId)}, ${s.available}, ${q(s.maxPerOrder)}) on conflict (warehouse_id, product_id) do nothing;`,
  );
}

// ---- identity: dev accounts. The password is for local development only.
const DEV_PASSWORD = "tokajo-dev";
const salt = Buffer.from("tokajo-dev-seed-salt-1234567890!".slice(0, 16));
const passwordHash = await hashPassword(DEV_PASSWORD, salt);
const WH = "wh-noida-62";
const uid = (n: number) => `00000000-0000-4000-8000-${String(n).padStart(12, "0")}`;

lines.push(
  "",
  "-- identity (dev accounts: staff and admin sign in with the password " + DEV_PASSWORD + ")",
);
const staff = [
  { id: uid(1), role: "admin", name: "Admin", email: "admin@tokajo.dev", wh: null },
  {
    id: uid(2),
    role: "warehouse_manager",
    name: "Noida Manager",
    email: "manager@tokajo.dev",
    wh: WH,
  },
  { id: uid(3), role: "warehouse_staff", name: "Noida Packer", email: "packer@tokajo.dev", wh: WH },
];
for (const u of staff) {
  lines.push(
    `insert into identity.users (id, role, name, email, password_hash, warehouse_id) values (${q(u.id)}, ${q(u.role)}, ${q(u.name)}, ${q(u.email)}, ${q(passwordHash)}, ${q(u.wh)}) on conflict (id) do nothing;`,
  );
}
const riders = [
  {
    id: uid(11),
    name: "Ravi Kumar",
    phone: "+919810000011",
    vehicle: "Bike, DL 8S 4521",
    rating: 4.8,
  },
  {
    id: uid(12),
    name: "Sunil Yadav",
    phone: "+919810000012",
    vehicle: "Bike, UP 16 AB 7710",
    rating: 4.6,
  },
  {
    id: uid(13),
    name: "Imran Ali",
    phone: "+919810000013",
    vehicle: "Scooter, UP 14 CD 2231",
    rating: 4.9,
  },
];
for (const r of riders) {
  lines.push(
    `insert into identity.users (id, role, name, phone) values (${q(r.id)}, 'rider', ${q(r.name)}, ${q(r.phone)}) on conflict (id) do nothing;`,
  );
  lines.push(
    `insert into identity.rider_profiles (user_id, vehicle, rating, warehouse_id) values (${q(r.id)}, ${q(r.vehicle)}, ${r.rating}, ${q(WH)}) on conflict (user_id) do nothing;`,
  );
}

lines.push("", "-- orders: sample coupons");
lines.push(
  `insert into orders.coupons (id, code, title, description, type, value, min_order_paise, usage_limit_per_user, first_order_only) values ('00000000-0000-4000-9000-000000000001', 'WELCOME50', '₹50 off your first order', 'On orders above ₹199', 'flat', 5000, 19900, 1, true) on conflict (id) do nothing;`,
  `insert into orders.coupons (id, code, title, description, type, value, min_order_paise, usage_limit_per_user, first_order_only) values ('00000000-0000-4000-9000-000000000002', 'FREEDEL', 'Free delivery', 'On orders above ₹149', 'free_delivery', 0, 14900, 3, false) on conflict (id) do nothing;`,
);

writeFileSync(
  path.resolve(import.meta.dirname, "..", "supabase", "seed.sql"),
  lines.join("\n") + "\n",
);
console.log(
  `seed.sql: ${staff.length} staff, ${riders.length} riders, ${seedCategories.length} categories, ${seedProducts.length} products, ${seedWarehouses.length} warehouses, ${seedStock.length} stock rows`,
);
