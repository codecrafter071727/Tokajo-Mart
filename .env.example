# Single env file for every Fastify service. Copy to `.env` in this directory:
#   cp .env.example .env
# ECS Fargate injects PORT=8080 and per-service DATABASE_URL; these
# GATEWAY_PORT / IDENTITY_DATABASE_URL names are for local processes only.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug
SENTRY_DSN=

# --- Local listen ports ---
GATEWAY_PORT=4000
IDENTITY_PORT=4001
CATALOG_PORT=4002
WAREHOUSE_INVENTORY_PORT=4003
ORDER_PORT=4004
PAYMENT_PORT=4005
DELIVERY_PORT=4006
NOTIFICATION_PORT=4007
ANALYTICS_PORT=4008

# --- Service-to-service URLs ---
IDENTITY_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
WAREHOUSE_INVENTORY_SERVICE_URL=http://localhost:4003
ORDER_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
DELIVERY_SERVICE_URL=http://localhost:4006
NOTIFICATION_SERVICE_URL=http://localhost:4007
ANALYTICS_SERVICE_URL=http://localhost:4008

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Supabase ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_HOOK_SECRET=
SUPABASE_SMS_HOOK_SECRET=

# Local: direct DB. Cloud: Supavisor pooler (transaction mode, port 6543), service role.
DATABASE_POOL_MAX=5
IDENTITY_DATABASE_URL=postgresql://svc_identity:postgres@127.0.0.1:54322/postgres
CATALOG_DATABASE_URL=postgresql://svc_catalog:postgres@127.0.0.1:54322/postgres
INVENTORY_DATABASE_URL=postgresql://svc_inventory:postgres@127.0.0.1:54322/postgres
ORDERS_DATABASE_URL=postgresql://svc_orders:postgres@127.0.0.1:54322/postgres
PAYMENTS_DATABASE_URL=postgresql://svc_payments:postgres@127.0.0.1:54322/postgres
DELIVERY_DATABASE_URL=postgresql://svc_delivery:postgres@127.0.0.1:54322/postgres
NOTIFICATIONS_DATABASE_URL=postgresql://svc_notifications:postgres@127.0.0.1:54322/postgres
ANALYTICS_DATABASE_URL=postgresql://analytics_ro:postgres@127.0.0.1:54322/postgres

# --- AWS / LocalStack ---
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566

# --- Maps, payments, messaging ---
GOOGLE_MAPS_SERVER_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT=
RESEND_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=msg91
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
SMS_PROVIDER_OTP_TEMPLATE_ID=
